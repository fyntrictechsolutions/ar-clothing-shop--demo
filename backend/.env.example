# Get a key at https://app.fashn.ai (API section). Keep it secret; never put it in the frontend.
FASHN_API_KEY=
# performance (~5s) | balanced (~8s) | quality (~12-17s)
FASHN_MODE=balanced
# Comma-separated origins allowed to call this API (your store's URL, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000,https://fyntrictechsolutions.github.io
RATE_LIMIT_PER_HOUR=20
